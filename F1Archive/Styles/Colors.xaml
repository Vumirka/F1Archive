<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

    <SolidColorBrush x:Key="Brush.BackgroundPrimary" Color="#EFEFEF"/>
    <SolidColorBrush x:Key="Brush.BackgroundSecondary" Color="#F7F7F7"/>
    <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.SurfaceElevated" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="#E4E4E6"/>
    <SolidColorBrush x:Key="Brush.BorderPrimary" Color="#0C0C0E"/>
    <SolidColorBrush x:Key="Brush.BorderSubtle" Color="#D2D2D6"/>
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#0C0C0E"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#3A3A40"/>
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#5B5B61"/>
    <SolidColorBrush x:Key="Brush.Accent" Color="#E10600"/>
    <SolidColorBrush x:Key="Brush.Success" Color="#1F7A3D"/>
    <SolidColorBrush x:Key="Brush.Warning" Color="#A15C00"/>
    <SolidColorBrush x:Key="Brush.Error" Color="#B3261E"/>
    <!-- Завжди темний фон (не змінюється в темних шапках) -->
    <SolidColorBrush x:Key="Brush.Asphalt" Color="#0C0C0E"/>
    <!-- Фон темних шапок: картинка від чорного до темно-бордового (Resources\hero.png) -->
    <ImageBrush x:Key="Brush.DarkPanel" ImageSource="pack://application:,,,/Resources/hero.png"/>
    <!-- Шрифти лежать у Resources\Fonts: вузький для заголовків і цифр, звичайний для тексту -->
    <FontFamily x:Key="Font.Display">/F1Archive;component/Resources/Fonts/#Fira Sans Extra Condensed, Bahnschrift Condensed, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Ui">/F1Archive;component/Resources/Fonts/#Fira Sans, Segoe UI</FontFamily>

    <BitmapImage x:Key="Icon.Home" UriSource="pack://application:,,,/Resources/Icons/home.png"/>
    <BitmapImage x:Key="Icon.Trophy" UriSource="pack://application:,,,/Resources/Icons/trophy.png"/>
    <BitmapImage x:Key="Icon.Driver" UriSource="pack://application:,,,/Resources/Icons/driver.png"/>
    <BitmapImage x:Key="Icon.Team" UriSource="pack://application:,,,/Resources/Icons/team.png"/>
    <BitmapImage x:Key="Icon.Circuit" UriSource="pack://application:,,,/Resources/Icons/circuit.png"/>
    <BitmapImage x:Key="Icon.Flag" UriSource="pack://application:,,,/Resources/Icons/flag.png"/>
    <BitmapImage x:Key="Icon.ArrowLeft" UriSource="pack://application:,,,/Resources/Icons/arrow-left.png"/>
    <BitmapImage x:Key="Icon.Wrench" UriSource="pack://application:,,,/Resources/Icons/wrench.png"/>

</ResourceDictionary>
