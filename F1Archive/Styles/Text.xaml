<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="Text.H3" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Display}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="Text.H2" TargetType="TextBlock" BasedOn="{StaticResource Text.H3}">
        <Setter Property="FontSize" Value="30"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
    </Style>

    <Style x:Key="Text.H1" TargetType="TextBlock" BasedOn="{StaticResource Text.H2}">
        <Setter Property="FontSize" Value="42"/>
    </Style>

    <Style x:Key="Text.Display" TargetType="TextBlock" BasedOn="{StaticResource Text.H2}">
        <Setter Property="FontSize" Value="72"/>
    </Style>

    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="Text.Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
    </Style>

    <!-- Цифра і підпис у смузі внизу темної шапки -->
    <Style x:Key="Text.BandValue" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Display}"/>
        <Setter Property="FontSize" Value="34"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="Text.BandLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <!-- Смуга з цифрами внизу темної шапки: список StatItem (цифра і підпис) -->
    <Style x:Key="StatsBand" TargetType="ItemsControl">
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel Margin="16,0">
                        <TextBlock Text="{Binding Value}" Style="{StaticResource Text.BandValue}"/>
                        <TextBlock Text="{Binding Label}" Style="{StaticResource Text.BandLabel}"/>
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Підпис над полем у формах редагування -->
    <Style x:Key="Text.Label" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
        <Setter Property="Margin" Value="0,12,0,4"/>
    </Style>

    <!-- Маленька червона мітка над заголовком -->
    <Style x:Key="Text.Overline" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Display}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
    </Style>

</ResourceDictionary>
