<!-- Кольори всередині темних шапок сторінок: світлий текст і темні картки -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#D4D4D9"/>
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#A0A0A8"/>
    <SolidColorBrush x:Key="Brush.BorderSubtle" Color="#2B2B30"/>
    <SolidColorBrush x:Key="Brush.BorderPrimary" Color="#5B5B61"/>
    <SolidColorBrush x:Key="Brush.Surface" Color="#17171A"/>
    <SolidColorBrush x:Key="Brush.SurfaceElevated" Color="#2B2B30"/>
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="#2B2B30"/>
</ResourceDictionary>
