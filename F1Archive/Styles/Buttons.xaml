<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Основа для всіх кнопок: рамка з фоном. Інші стилі міняють лише кольори і відступи. -->
    <Style x:Key="Button.Base" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Основна дія: червона кнопка -->
    <Style x:Key="Button.Primary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Display}"/>
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
        <Setter Property="Padding" Value="22,9"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Error}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Другорядна дія: кнопка з чорною рамкою -->
    <Style x:Key="Button.Secondary" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.TextPrimary}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.TextPrimary}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Surface}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Біла кнопка на темному або червоному фоні -->
    <Style x:Key="Button.Light" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="#0C0C0E"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#E4E4E6"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Видалення: червона рамка -->
    <Style x:Key="Button.Danger" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Error}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Error}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Error}"/>
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Картка-кнопка: біла з чорною рамкою, при наведенні світло-сірий фон -->
    <Style x:Key="Card.Plain" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderPrimary}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Картка з червоною тінню: при наведенні зсувається вгору-вліво, а за нею видно червоний квадрат -->
    <Style x:Key="Card.Interactive" TargetType="Button" BasedOn="{StaticResource Card.Plain}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Shadow"
                                Margin="6,6,-6,-6"
                                Background="{DynamicResource Brush.Accent}"
                                Opacity="0"/>
                        <Border x:Name="Root"
                                Background="{DynamicResource Brush.Surface}"
                                BorderBrush="{DynamicResource Brush.BorderPrimary}"
                                BorderThickness="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </Grid>
                    <!-- Плавно: картка за 0.15 с зсувається на 3 пікселі, тінь проявляється -->
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ThicknessAnimation Storyboard.TargetName="Root"
                                                            Storyboard.TargetProperty="Margin"
                                                            To="-3,-3,3,3"
                                                            Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetName="Shadow"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ThicknessAnimation Storyboard.TargetName="Root"
                                                            Storyboard.TargetProperty="Margin"
                                                            To="0"
                                                            Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetName="Shadow"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Рядок таблиці з лінією знизу (залік сезону) -->
    <Style x:Key="Row.Line" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="0,10"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Текст-посилання (ім'я гонщика, назва команди): при наведенні стає червоним -->
    <Style x:Key="Link.Button" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Хлібні крихти -->
    <Style x:Key="Breadcrumb.Link" TargetType="Button" BasedOn="{StaticResource Link.Button}">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
    </Style>

    <!-- Кнопка-фільтр: однакова для RadioButton і CheckBox -->
    <Style x:Key="Chip.Base" TargetType="ToggleButton">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Display}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderPrimary}"/>
        <Setter Property="Padding" Value="15,7"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="2"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" RecognizesAccessKey="False"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHover}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.TextPrimary}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Surface}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Chip" TargetType="RadioButton" BasedOn="{StaticResource Chip.Base}"/>
    <!-- Усі RadioButton на сторінках за замовчуванням мають вигляд кнопки-фільтра -->
    <Style TargetType="RadioButton" BasedOn="{StaticResource Chip}"/>
    <Style x:Key="ChipCheck" TargetType="CheckBox" BasedOn="{StaticResource Chip.Base}"/>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderPrimary}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Padding" Value="22"/>
    </Style>

    <!-- Рядок таблиці: при наведенні сірий фон -->
    <Style x:Key="Row.Hover" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Як розкладати картки у списках: в рядок з переносом або рівними колонками -->
    <ItemsPanelTemplate x:Key="Panel.Wrap">
        <WrapPanel/>
    </ItemsPanelTemplate>
    <ItemsPanelTemplate x:Key="Panel.Columns3">
        <UniformGrid Columns="3"/>
    </ItemsPanelTemplate>
    <ItemsPanelTemplate x:Key="Panel.Columns4">
        <UniformGrid Columns="4"/>
    </ItemsPanelTemplate>
    <ItemsPanelTemplate x:Key="Panel.Columns5">
        <UniformGrid Columns="5"/>
    </ItemsPanelTemplate>

</ResourceDictionary>
