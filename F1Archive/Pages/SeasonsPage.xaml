<UserControl x:Class="F1Archive.Pages.SeasonsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:F1Archive.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1280"
             d:DesignHeight="900"
             Background="{DynamicResource Brush.BackgroundPrimary}">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border MaxWidth="1320" Margin="32,28,32,48">
                <StackPanel>
                    <TextBlock Text="СЕЗОНИ" Style="{StaticResource Text.Overline}"/>
                    <TextBlock Text="Сезони Формули 1" Margin="0,6,0,0" Style="{StaticResource Text.H1}"/>
                    <TextBlock x:Name="SummaryText" Margin="0,8,0,20" Style="{StaticResource Text.Body}"/>
                    <!-- ===== Картки сезонів: на кожній фото чемпіона того року ===== -->
                    <ItemsControl x:Name="CardsList" ItemsPanel="{StaticResource Panel.Columns4}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Card.Interactive}"
                                        Height="260"
                                        Padding="0"
                                        Margin="0,0,16,16"
                                        Click="Card_Click">
                                    <Grid Background="#0C0C0E" ClipToBounds="True">
                                        <!-- Фото чемпіона праворуч, лівий край плавно зникає в темному фоні -->
                                        <ctl:MediaImage Width="170"
                                                        HorizontalAlignment="Right"
                                                        SourcePath="{Binding ChampionPhoto}">
                                            <!-- Прозорість з картинки Resources\fade-left.png -->
                                            <ctl:MediaImage.OpacityMask>
                                                <ImageBrush ImageSource="/Resources/fade-left.png"/>
                                            </ctl:MediaImage.OpacityMask>
                                        </ctl:MediaImage>
                                        <Grid Margin="20,16,20,18">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Year}"
                                                           FontFamily="{DynamicResource Font.Display}"
                                                           FontSize="56"
                                                           FontWeight="ExtraBold"
                                                           Foreground="White"/>
                                                <TextBlock Text="{Binding RoundsText}"
                                                           FontSize="13"
                                                           Foreground="White"/>
                                            </StackPanel>
                                            <!-- Позначка для сезону, що ще триває -->
                                            <Border HorizontalAlignment="Left"
                                                    VerticalAlignment="Bottom"
                                                    Grid.Row="1"
                                                    Margin="0,0,0,10"
                                                    Padding="8,3"
                                                    Background="{DynamicResource Brush.Accent}"
                                                    Visibility="{Binding InProgress, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="ТРИВАЄ"
                                                           FontFamily="{DynamicResource Font.Display}"
                                                           FontSize="13"
                                                           FontWeight="Bold"
                                                           Foreground="White"/>
                                            </Border>
                                            <StackPanel Grid.Row="2">
                                                <TextBlock Text="{Binding ChampionDriver}"
                                                           FontFamily="{DynamicResource Font.Display}"
                                                           FontSize="22"
                                                           FontWeight="Bold"
                                                           Foreground="White"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding ChampionTeam}"
                                                           Margin="0,4,0,0"
                                                           FontSize="14"
                                                           Foreground="#D4D4D9"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
