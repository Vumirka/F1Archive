<UserControl x:Class="F1Archive.Pages.GrandPrixDetailsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Brush.BackgroundPrimary}">
    <UserControl.Resources>
        <!-- Посилання-текст у плитках (гонщик, траса) -->
        <Style x:Key="TileLink" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="Text"
                                   Text="{TemplateBinding Content}"
                                   FontFamily="{TemplateBinding FontFamily}"
                                   FontSize="{TemplateBinding FontSize}"
                                   FontWeight="{TemplateBinding FontWeight}"
                                   Foreground="{TemplateBinding Foreground}"
                                   TextWrapping="Wrap"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Text" Property="TextDecorations" Value="Underline"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Text" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Великі білі посилання в смузі внизу шапки (поул, найшвидше коло, траса) -->
        <Style x:Key="TileLink.Band" TargetType="Button" BasedOn="{StaticResource TileLink}">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Display}"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="HeaderCell" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ResultCell" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border MaxWidth="1320" Margin="32,24,32,48">
            <StackPanel>
                <Border ClipToBounds="True" Background="{DynamicResource Brush.DarkPanel}">
                    <Border.Resources>
                        <ResourceDictionary Source="/F1Archive;component/Styles/Dark.xaml"/>
                    </Border.Resources>
                    <StackPanel>
                        <StackPanel Margin="48,36,48,32">
                            <TextBlock x:Name="RoundChipText" Style="{StaticResource Text.Overline}"/>
                            <TextBlock x:Name="NameText" Margin="0,4,0,0" TextWrapping="Wrap" Style="{StaticResource Text.Display}" FontSize="56"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock x:Name="DateText" VerticalAlignment="Center" Style="{StaticResource Text.Body}" FontSize="16"/>
                                <TextBlock Text="·" Margin="10,0" VerticalAlignment="Center" Style="{StaticResource Text.Body}" FontSize="16"/>
                                <Button x:Name="HeroCircuitButton"
                                        Style="{StaticResource TileLink}"
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource Brush.TextPrimary}"
                                        VerticalAlignment="Center"
                                        ToolTip="Відкрити сторінку траси"
                                        Click="Circuit_Click"/>
                                <TextBlock x:Name="CountryText"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource Text.Body}"
                                           FontSize="16"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                                <Button x:Name="PrevButton"
                                        Content="←  Попередній етап"
                                        Style="{StaticResource Button.Light}"
                                        Margin="0,0,12,0"
                                        Visibility="Collapsed"
                                        Click="Prev_Click"/>
                                <Button x:Name="NextButton"
                                        Content="Наступний етап  →"
                                        Style="{StaticResource Button.Light}"
                                        Visibility="Collapsed"
                                        Click="Next_Click"/>
                            </StackPanel>
                        </StackPanel>
                        <!-- Основні дані гонки: смуга внизу шапки -->
                        <Border BorderBrush="#2B2B30" BorderThickness="0,1,0,0" Background="#990C0C0E">
                            <UniformGrid Rows="1" Margin="32,16">
                                <StackPanel Margin="16,0">
                                    <TextBlock x:Name="RoundValue" Style="{StaticResource Text.BandValue}"/>
                                    <TextBlock x:Name="RoundSub" Text="етап" Style="{StaticResource Text.BandLabel}"/>
                                </StackPanel>
                                <StackPanel Margin="16,0">
                                    <TextBlock x:Name="LapsValue" Style="{StaticResource Text.BandValue}"/>
                                    <TextBlock Text="кіл" Style="{StaticResource Text.BandLabel}"/>
                                </StackPanel>
                                <StackPanel Margin="16,0">
                                    <Button x:Name="PoleButton" Style="{StaticResource TileLink.Band}" Click="Pole_Click"/>
                                    <TextBlock Text="поул" Style="{StaticResource Text.BandLabel}"/>
                                </StackPanel>
                                <StackPanel Margin="16,0">
                                    <Button x:Name="FastestButton" Style="{StaticResource TileLink.Band}" Click="Fastest_Click"/>
                                    <TextBlock x:Name="FastestSub" Text="найшвидше коло" Style="{StaticResource Text.BandLabel}"/>
                                </StackPanel>
                                <StackPanel Margin="16,0">
                                    <Button x:Name="CircuitTileButton" Style="{StaticResource TileLink.Band}" Click="Circuit_Click"/>
                                    <TextBlock Text="траса" Style="{StaticResource Text.BandLabel}"/>
                                </StackPanel>
                            </UniformGrid>
                        </Border>
                    </StackPanel>
                </Border>
                <!-- Вкладки: результати, кваліфікація, піт-стопи (показується одна, щоб не гортати довго) -->
                <WrapPanel Margin="0,56,0,0" ToggleButton.Checked="Tab_Checked">
                    <RadioButton Content="Результати гонки" Tag="results" IsChecked="True"/>
                    <RadioButton x:Name="QualifyingTab" Content="Кваліфікація" Tag="qualifying" Visibility="Collapsed"/>
                    <RadioButton x:Name="PitStopsTab" Content="Піт-стопи" Tag="pits" Visibility="Collapsed"/>
                </WrapPanel>
                <StackPanel x:Name="ResultsSection" Margin="0,8,0,0">
                    <TextBlock Text="Результати гонки" Style="{StaticResource Text.H2}"/>
                    <TextBlock x:Name="ResultsEmpty"
                               Text="Результати цього Гран-прі відсутні."
                               Margin="0,16,0,0"
                               Style="{StaticResource Text.Body}"
                               Visibility="Collapsed"/>
                    <Border x:Name="ResultsCard"
                            Style="{StaticResource Card}"
                            Padding="0"
                            Margin="0,16,0,0"
                            ClipToBounds="True"
                            Visibility="Collapsed">
                        <!-- На вузькому екрані таблиця прокручується по горизонталі -->
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled"
                                      PreviewMouseWheel="TableScroll_PreviewMouseWheel">
                            <StackPanel MinWidth="1010">
                                <!-- Заголовок таблиці: ширини колонок такі ж, як у рядках нижче -->
                                <Border BorderBrush="{DynamicResource Brush.BorderPrimary}" BorderThickness="0,0,0,1" Padding="0,12">
                                    <Border.Resources>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource HeaderCell}"/>
                                    </Border.Resources>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="56"/>
                                            <ColumnDefinition MinWidth="200"/>
                                            <ColumnDefinition Width="190"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="64"/>
                                            <ColumnDefinition Width="76"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="150"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="ПОЗ." Margin="12,0,0,0"/>
                                        <TextBlock Grid.Column="1" Text="ГОНЩИК"/>
                                        <TextBlock Grid.Column="2" Text="КОМАНДА"/>
                                        <TextBlock Grid.Column="3" Text="СТАРТ"/>
                                        <TextBlock Grid.Column="4" Text="КОЛА"/>
                                        <TextBlock Grid.Column="5" Text="ОЧКИ"/>
                                        <TextBlock Grid.Column="6" Text="СТАТУС"/>
                                        <TextBlock Grid.Column="7" Text="ЧАС / ПРИЧИНА СХОДУ"/>
                                    </Grid>
                                </Border>
                                <ItemsControl x:Name="ResultsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- Рядок таблиці результатів. Ширини колонок збігаються із заголовком на сторінці. -->
                                            <Border BorderBrush="{DynamicResource Brush.BorderSubtle}"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="0,9"
                                                    ToolTip="{Binding Status}"
                                                    Style="{StaticResource Row.Hover}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="56"/>
                                                        <ColumnDefinition MinWidth="200"/>
                                                        <ColumnDefinition Width="190"/>
                                                        <ColumnDefinition Width="140"/>
                                                        <ColumnDefinition Width="64"/>
                                                        <ColumnDefinition Width="76"/>
                                                        <ColumnDefinition Width="150"/>
                                                        <ColumnDefinition Width="150"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Місце: порожнє місце не замінюється нулем -->
                                                    <TextBlock Text="{Binding FinishPosition, TargetNullValue=—}"
                                                               Margin="12,0,0,0"
                                                               FontFamily="{DynamicResource Font.Display}"
                                                               FontSize="17"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsWinner}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <!-- Гонщик: ім'я-посилання, номер боліда й позначка спільного боліда -->
                                                    <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                                        <Button Content="{Binding DriverName}"
                                                                Style="{StaticResource Link.Button}"
                                                                FontFamily="{DynamicResource Font.Ui}"
                                                                FontSize="15"
                                                                FontWeight="SemiBold"
                                                                Foreground="{DynamicResource Brush.TextPrimary}"
                                                                Click="ResultDriver_Click"/>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding CarNumberText}"
                                                                       Margin="0,0,10,0"
                                                                       Style="{StaticResource Text.Caption}"
                                                                       />
                                                            <Border Padding="7,1"
                                                                    Background="{DynamicResource Brush.SurfaceElevated}"
                                                                    ToolTip="Спільний болід: у ранніх сезонах двоє гонщиків могли ділити один болід, і результат зараховувався їм разом."
                                                                    Visibility="{Binding IsShared, Converter={StaticResource BoolToVisibility}}">
                                                                <TextBlock Text="Спільний болід"
                                                                           FontFamily="{DynamicResource Font.Ui}"
                                                                           FontSize="10"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource Brush.Warning}"/>
                                                            </Border>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <Button Grid.Column="2"
                                                            Content="{Binding TeamName}"
                                                            Margin="0,0,12,0"
                                                            VerticalAlignment="Center"
                                                            Style="{StaticResource Link.Button}"
                                                            FontFamily="{DynamicResource Font.Ui}"
                                                            FontSize="14"
                                                            Foreground="{DynamicResource Brush.TextSecondary}"
                                                            Click="ResultTeam_Click"/>
                                                    <!-- Старт і зміна позиції; для порожнього старту — риска -->
                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding GridText}" MinWidth="34" Style="{StaticResource ResultCell}"/>
                                                        <TextBlock Text="{Binding ChangeText}"
                                                                   Margin="8,0,0,0"
                                                                   FontWeight="Bold"
                                                                   VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding ChangeKind}" Value="up">
                                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Success}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding ChangeKind}" Value="down">
                                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Error}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="4"
                                                               Text="{Binding LapsCompleted, TargetNullValue=—}"
                                                               Style="{StaticResource ResultCell}"/>
                                                    <TextBlock Grid.Column="5"
                                                               Text="{Binding PointsText}"
                                                               Style="{StaticResource ResultCell}"
                                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                                               FontWeight="SemiBold"/>
                                                    <TextBlock Grid.Column="6" Text="{Binding StatusText}" Margin="0,0,12,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource ResultCell}">
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding StatusKind}" Value="finished">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Success}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding StatusKind}" Value="dsq">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Error}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Grid.Column="7"
                                                               Text="{Binding TimeText}"
                                                               Margin="0,0,12,0"
                                                               Style="{StaticResource ResultCell}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
                <StackPanel x:Name="QualifyingSection" Margin="0,8,0,0" Visibility="Collapsed">
                    <TextBlock Text="Кваліфікація" Style="{StaticResource Text.H2}"/>
                    <Border Style="{StaticResource Card}" Padding="0" Margin="0,16,0,0">
                        <StackPanel>
                            <Border Background="{DynamicResource Brush.Asphalt}" Padding="0,10">
                                <Border.Resources>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource HeaderCell}">
                                        <Setter Property="Foreground" Value="White"/>
                                    </Style>
                                </Border.Resources>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="ПОЗ." Margin="16,0,0,0"/>
                                    <TextBlock Grid.Column="1" Text="ГОНЩИК"/>
                                    <TextBlock Grid.Column="2" Text="КОМАНДА"/>
                                    <TextBlock Grid.Column="3" Text="Q1"/>
                                    <TextBlock Grid.Column="4" Text="Q2"/>
                                    <TextBlock Grid.Column="5" Text="Q3"/>
                                </Grid>
                            </Border>
                            <ItemsControl x:Name="QualifyingList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="0,0,0,1" Padding="0,9">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="64"/>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="200"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="110"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Position, TargetNullValue=—}"
                                                           Margin="16,0,0,0"
                                                           FontFamily="{DynamicResource Font.Display}"
                                                           FontSize="18"
                                                           FontWeight="ExtraBold"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Position}" Value="1">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Button Grid.Column="1"
                                                        Content="{Binding Driver.FullName}"
                                                        Tag="{Binding DriverId}"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        FontSize="15"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource Brush.TextPrimary}"
                                                        Style="{StaticResource Breadcrumb.Link}"
                                                        ToolTip="Відкрити профіль гонщика"
                                                        Click="ExtrasDriver_Click"/>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Team.Name}"
                                                           Style="{StaticResource Text.Body}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding Q1, TargetNullValue=—}"
                                                           Style="{StaticResource Text.Body}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="4"
                                                           Text="{Binding Q2, TargetNullValue=—}"
                                                           Style="{StaticResource Text.Body}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="5"
                                                           Text="{Binding Q3, TargetNullValue=—}"
                                                           Style="{StaticResource Text.Body}"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Brush.TextPrimary}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel x:Name="PitStopsSection" Margin="0,8,0,0" Visibility="Collapsed">
                    <TextBlock Text="Піт-стопи" Style="{StaticResource Text.H2}"/>
                    <Border Style="{StaticResource Card}" Padding="0" Margin="0,16,0,0">
                        <StackPanel>
                            <Border Background="{DynamicResource Brush.Asphalt}" Padding="0,10">
                                <Border.Resources>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource HeaderCell}">
                                        <Setter Property="Foreground" Value="White"/>
                                    </Style>
                                </Border.Resources>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="160"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="ГОНЩИК" Margin="16,0,0,0"/>
                                    <TextBlock Grid.Column="1" Text="ЗУПИНОК"/>
                                    <TextBlock Grid.Column="2" Text="НА КОЛАХ"/>
                                    <TextBlock Grid.Column="3" Text="НАЙКРАЩА"/>
                                </Grid>
                            </Border>
                            <ItemsControl x:Name="PitStopsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="0,0,0,1" Padding="0,9">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="200"/>
                                                    <ColumnDefinition Width="160"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Content="{Binding DriverName}"
                                                        Tag="{Binding DriverId}"
                                                        Margin="16,0,0,0"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        FontSize="15"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource Brush.TextPrimary}"
                                                        Style="{StaticResource Breadcrumb.Link}"
                                                        ToolTip="Відкрити профіль гонщика"
                                                        Click="ExtrasDriver_Click"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Count}"
                                                           FontFamily="{DynamicResource Font.Display}"
                                                           FontSize="18"
                                                           FontWeight="ExtraBold"
                                                           Foreground="{DynamicResource Brush.TextPrimary}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Laps}"
                                                           Style="{StaticResource Text.Body}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding Best}"
                                                           Style="{StaticResource Text.Body}"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
