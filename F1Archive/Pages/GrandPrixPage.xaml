<UserControl x:Class="F1Archive.Pages.GrandPrixPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Brush.BackgroundPrimary}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border MaxWidth="1320" Margin="32,28,32,48">
            <StackPanel>
                <TextBlock Text="ГРАН-ПРІ" Style="{StaticResource Text.Overline}"/>
                <TextBlock Text="Гран-прі Формули 1" Margin="0,6,0,0" Style="{StaticResource Text.H1}"/>
                <TextBlock x:Name="SummaryText" Margin="0,8,0,20" Style="{StaticResource Text.Body}"/>
                <!-- Фільтри: пошук і сезон зліва -->
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBox x:Name="SearchBox"
                             Width="320"
                             Margin="0,0,12,8"
                             Style="{StaticResource TextBox.Search}"
                             Tag="Назва, траса або країна"
                             TextChanged="Filter_Changed"/>
                    <ComboBox x:Name="SeasonCombo"
                              Width="170"
                              Margin="0,0,12,8"
                              Style="{StaticResource ComboBox.Base}"
                              SelectionChanged="Filter_Changed"/>
                </StackPanel>
                <TextBlock x:Name="CountText" Margin="0,6,0,14" Style="{StaticResource Text.Caption}"/>
                <!-- Картки Гран-прі: світлі, чотири в ряд, усі однакової висоти -->
                <ItemsControl x:Name="CardsList" ItemsPanel="{StaticResource Panel.Columns3}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Картка Гран-прі: етап і дата, червоний рік, назва, траса і переможець з кубком -->
                            <Button Style="{StaticResource Card.Interactive}" Height="190" Padding="20,16" Margin="0,0,16,16" Click="Card_Click">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <DockPanel>
                                        <TextBlock Text="{Binding Year}"
                                                   DockPanel.Dock="Right"
                                                   FontFamily="{DynamicResource Font.Display}"
                                                   FontSize="22"
                                                   FontWeight="ExtraBold"
                                                   Foreground="{DynamicResource Brush.Accent}"/>
                                        <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Caption}">
                                            <Run Text="{Binding RoundText, Mode=OneWay}"
                                                 FontWeight="Bold"
                                                 Foreground="{DynamicResource Brush.TextPrimary}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding DateText, Mode=OneWay}"/>
                                        </TextBlock>
                                    </DockPanel>
                                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   FontFamily="{DynamicResource Font.Display}"
                                                   FontSize="22"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding CircuitText}"
                                                   Style="{StaticResource Text.Caption}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                                        <Image Source="{StaticResource Icon.Trophy}" Width="18" Height="18" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding WinnerName}"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button x:Name="MoreButton"
                        Style="{StaticResource Button.Secondary}"
                        HorizontalAlignment="Center"
                        Margin="0,8,0,0"
                        Padding="32,12"
                        Visibility="Collapsed"
                        Click="More_Click"/>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
