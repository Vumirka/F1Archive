<UserControl x:Class="F1Archive.Pages.DriversPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:F1Archive.Controls"
             Background="{DynamicResource Brush.BackgroundPrimary}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border MaxWidth="1320" Margin="32,28,32,48">
            <StackPanel>
                <TextBlock Text="ГОНЩИКИ" Style="{StaticResource Text.Overline}"/>
                <TextBlock Text="Гонщики Формули 1" Margin="0,6,0,0" Style="{StaticResource Text.H1}"/>
                <TextBlock x:Name="SummaryText" Margin="0,8,0,20" Style="{StaticResource Text.Body}"/>
                <!-- Фільтри: пошук і "Чемпіони" зліва -->
                <DockPanel Margin="0,8,0,0">
                    <Button DockPanel.Dock="Right"
                            Content="Випадковий гонщик"
                            Style="{StaticResource Button.Secondary}"
                            VerticalAlignment="Top"
                            Click="Random_Click"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                        <TextBox x:Name="SearchBox"
                                 Width="320"
                                 Margin="0,0,12,8"
                                 Style="{StaticResource TextBox.Search}"
                                 Tag="Пошук за ім'ям або країною"
                                 TextChanged="Filter_Changed"/>
                        <CheckBox x:Name="ChampionsCheck"
                                  Content="Лише чемпіони світу"
                                  Style="{StaticResource ChipCheck}"
                                  VerticalAlignment="Top"
                                  Click="Filter_Changed"/>
                    </StackPanel>
                </DockPanel>
                <TextBlock x:Name="CountText" Margin="0,6,0,14" Style="{StaticResource Text.Caption}"/>
                <!-- Картки гонщиків: фото зліва показується повністю, дані справа -->
                <ItemsControl x:Name="CardsList" ItemsPanel="{StaticResource Panel.Columns4}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Картка гонщика: портрет згори, прізвище великими літерами, цифри кар'єри внизу -->
                            <Button Style="{StaticResource Card.Interactive}" Height="380" Padding="0" Margin="0,0,16,16" Click="Card_Click">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <ctl:MediaImage DecodeWidth="400" SourcePath="{Binding ImagePath}"/>
                                    <!-- Титули: червона плашка на фото -->
                                    <Border HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Padding="10,4"
                                            Background="{DynamicResource Brush.Accent}"
                                            Visibility="{Binding IsChampion, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding ChampionBadge}"
                                                   FontFamily="{DynamicResource Font.Display}"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Foreground="White"/>
                                    </Border>
                                    <StackPanel Grid.Row="1" Margin="16,12,16,14">
                                        <TextBlock Text="{Binding FirstName}"
                                                   FontSize="14"
                                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding LastName}"
                                                   FontFamily="{DynamicResource Font.Display}"
                                                   FontSize="24"
                                                   FontWeight="ExtraBold"
                                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding Country, Mode=OneWay}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding YearsText, Mode=OneWay}"/>
                                        </TextBlock>
                                        <Border Height="1" Margin="0,10,0,8" Background="{DynamicResource Brush.BorderSubtle}"/>
                                        <UniformGrid Columns="3">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Wins}" Style="{StaticResource Text.H3}" FontSize="18"/>
                                                <TextBlock Text="перемог" Style="{StaticResource Text.Caption}" FontSize="12"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Podiums}" Style="{StaticResource Text.H3}" FontSize="18"/>
                                                <TextBlock Text="подіумів" Style="{StaticResource Text.Caption}" FontSize="12"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Poles}" Style="{StaticResource Text.H3}" FontSize="18"/>
                                                <TextBlock Text="поулів" Style="{StaticResource Text.Caption}" FontSize="12"/>
                                            </StackPanel>
                                        </UniformGrid>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button x:Name="MoreButton"
                        Style="{StaticResource Button.Secondary}"
                        HorizontalAlignment="Center"
                        Margin="0,8,0,0"
                        Padding="32,12"
                        Visibility="Collapsed"
                        Click="More_Click"/>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
