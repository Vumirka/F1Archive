<UserControl x:Class="F1Archive.Pages.SeasonDetailsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:F1Archive.Controls"
             Background="{DynamicResource Brush.BackgroundPrimary}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border MaxWidth="1320" Margin="32,24,32,48">
            <StackPanel>
                <Border Background="{DynamicResource Brush.DarkPanel}" ClipToBounds="True">
                    <Border.Resources>
                        <ResourceDictionary Source="/F1Archive;component/Styles/Dark.xaml"/>
                    </Border.Resources>
                    <StackPanel>
                        <StackPanel Margin="48,36,48,32">
                            <TextBlock Text="СЕЗОН ФОРМУЛИ 1" Style="{StaticResource Text.Overline}"/>
                            <TextBlock x:Name="HeroTitle" Margin="0,4,0,0" Style="{StaticResource Text.Display}" FontSize="56"/>
                            <TextBlock x:Name="HeroSubtitle" Margin="0,8,0,0" Style="{StaticResource Text.Body}" FontSize="16"/>
                        </StackPanel>
                        <Border BorderBrush="#2B2B30" BorderThickness="0,1,0,0" Background="#990C0C0E">
                            <ItemsControl x:Name="StatsList" Margin="32,16" Style="{StaticResource StatsBand}"/>
                        </Border>
                    </StackPanel>
                </Border>
                <UniformGrid Columns="2" Margin="0,24,0,0">
                    <ctl:ChampionCard x:Name="DriverCard" Margin="0,0,8,0" Overline="ЧЕМПІОН СВІТУ" Click="DriverCard_Click"/>
                    <ctl:ChampionCard x:Name="TeamCard" Margin="8,0,0,0" Overline="КУБОК КОНСТРУКТОРІВ" IsLogo="True" Click="TeamCard_Click"/>
                </UniformGrid>
                <!-- ===== Календар: компактна сітка етапів ===== -->
                <StackPanel x:Name="CalendarSection" Margin="0,36,0,0">
                    <TextBlock Text="Календар сезону" Style="{StaticResource Text.H2}"/>
                    <ItemsControl x:Name="CalendarList" Margin="0,16,0,0" ItemsPanel="{StaticResource Panel.Columns4}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Card.Interactive}" Padding="16,14" Margin="0,0,14,14" Click="CalendarItem_Click">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="{Binding DateText}" DockPanel.Dock="Right" Style="{StaticResource Text.Caption}"/>
                                            <TextBlock Text="{Binding RoundText}" Style="{StaticResource Text.Overline}"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Name}"
                                                   Margin="0,6,0,0"
                                                   Style="{StaticResource Text.H3}"
                                                   FontSize="18"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap"/>
                                        <TextBlock Text="{Binding CircuitText}"
                                                   Style="{StaticResource Text.Caption}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Border Height="1" Margin="0,10,0,8" Background="{DynamicResource Brush.BorderSubtle}"/>
                                        <TextBlock Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis">
                                            <Run Text="Переможець: "/>
                                            <Run Text="{Binding WinnerName, Mode=OneWay}"
                                                 FontWeight="SemiBold"
                                                 Foreground="{DynamicResource Brush.TextPrimary}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <StackPanel x:Name="StandingsSection" Margin="0,22,0,0">
                    <TextBlock Text="Особистий залік" Style="{StaticResource Text.H2}"/>
                    <!-- Заголовок таблиці (ширини збігаються з рядками) -->
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1.6*"/>
                            <ColumnDefinition Width="84"/>
                            <ColumnDefinition Width="84"/>
                            <ColumnDefinition Width="84"/>
                            <ColumnDefinition Width="84"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="ПОЗ" HorizontalAlignment="Center" Style="{StaticResource Text.Caption}"/>
                        <TextBlock Grid.Column="1" Text="ГОНЩИК" Style="{StaticResource Text.Caption}"/>
                        <TextBlock Grid.Column="2" Text="КОМАНДА" Style="{StaticResource Text.Caption}"/>
                        <TextBlock Grid.Column="3" Text="ОЧКИ" HorizontalAlignment="Center" Style="{StaticResource Text.Caption}"/>
                        <TextBlock Grid.Column="4" Text="ПЕРЕМОГИ" HorizontalAlignment="Center" Style="{StaticResource Text.Caption}"/>
                        <TextBlock Grid.Column="5" Text="ПОДІУМИ" HorizontalAlignment="Center" Style="{StaticResource Text.Caption}"/>
                        <TextBlock Grid.Column="6" Text="ПОУЛИ" HorizontalAlignment="Center" Style="{StaticResource Text.Caption}"/>
                    </Grid>
                    <Border Height="1" Margin="0,8,0,0" Background="{DynamicResource Brush.BorderPrimary}"/>
                    <ItemsControl x:Name="StandingsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Row.Line}" Click="StandingRow_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="56"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="1.6*"/>
                                            <ColumnDefinition Width="84"/>
                                            <ColumnDefinition Width="84"/>
                                            <ColumnDefinition Width="84"/>
                                            <ColumnDefinition Width="84"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Position}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.H3}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLeader}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding DriverName}"
                                                       Style="{StaticResource Text.H3}"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap"/>
                                            <TextBlock Text="{Binding Country}" Style="{StaticResource Text.Caption}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Teams}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,0"
                                                   Style="{StaticResource Text.Body}"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap"
                                                   ToolTip="{Binding Teams}"/>
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding PointsText}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource Text.H3}"/>
                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding Wins}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource Text.Body}"/>
                                        <TextBlock Grid.Column="5"
                                                   Text="{Binding Podiums}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource Text.Body}"/>
                                        <TextBlock Grid.Column="6"
                                                   Text="{Binding Poles}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource Text.Body}"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- Спочатку видно перших 10, решта за кнопкою -->
                    <Button x:Name="AllStandingsButton"
                            Style="{StaticResource Button.Secondary}"
                            HorizontalAlignment="Center"
                            Margin="0,16,0,0"
                            Click="AllStandings_Click"/>
                </StackPanel>
                <StackPanel x:Name="ParticipantsSection" Margin="0,36,0,0">
                    <TextBlock Text="Учасники сезону" Style="{StaticResource Text.H2}"/>
                    <ItemsControl x:Name="ParticipantsList" Margin="0,16,0,0" ItemsPanel="{StaticResource Panel.Columns4}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Card.Plain}" Padding="16" Margin="0,0,14,14" Click="TeamEntry_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <ctl:MediaImage Width="44"
                                                        Height="44"
                                                        VerticalAlignment="Top"
                                                        ImageStretch="Uniform"
                                                        DecodeWidth="120"
                                                        SourcePath="{Binding LogoPath}"/>
                                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                            <TextBlock Text="{Binding TeamName}"
                                                       Style="{StaticResource Text.H3}"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap"/>
                                            <TextBlock Text="{Binding Country}" Style="{StaticResource Text.Caption}"/>
                                            <TextBlock Text="{Binding Drivers}" Margin="0,8,0,0" Style="{StaticResource Text.Body}" FontSize="14"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
