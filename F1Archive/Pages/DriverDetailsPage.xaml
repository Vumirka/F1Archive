<UserControl x:Class="F1Archive.Pages.DriverDetailsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:F1Archive.Controls"
             Background="{DynamicResource Brush.BackgroundPrimary}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border MaxWidth="1320" Margin="32,24,32,48">
            <StackPanel>
                <Border ClipToBounds="True" Background="{DynamicResource Brush.DarkPanel}">
                    <Border.Resources>
                        <ResourceDictionary Source="/F1Archive;component/Styles/Dark.xaml"/>
                    </Border.Resources>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <!-- Великий номер на фоні. Height="0": він не розтягує шапку, а просто видніється за текстом -->
                        <TextBlock x:Name="HeroNumber"
                                   Height="0"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Top"
                                   Margin="0,-70,28,0"
                                   FontFamily="{DynamicResource Font.Display}"
                                   FontSize="400"
                                   FontWeight="ExtraBold"
                                   FontStyle="Italic"
                                   Foreground="#40E10600"
                                   IsHitTestVisible="False"/>
                        <!-- Затемнення, щоб білий текст читався (картинка Resources\hero-shade.png) -->
                        <Rectangle IsHitTestVisible="False">
                            <Rectangle.Fill>
                                <ImageBrush ImageSource="/Resources/hero-shade.png"/>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Grid Margin="48,36,48,32">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <ctl:MediaImage x:Name="Portrait"
                                            Width="210"
                                            Height="250"
                                            DecodeWidth="640"
                                            VerticalAlignment="Top"
                                            BorderBrush="White"
                                            BorderThickness="2"/>
                            <StackPanel Grid.Column="1" Margin="32,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="CountryBadge"
                                            Padding="9,3"
                                            Margin="0,0,10,0"
                                            Background="White"
                                            VerticalAlignment="Center"
                                            Visibility="Collapsed">
                                        <TextBlock x:Name="CountryCodeText"
                                                   FontFamily="{DynamicResource Font.Display}"
                                                   FontSize="15"
                                                   FontWeight="ExtraBold"
                                                   Foreground="#0C0C0E"/>
                                    </Border>
                                    <TextBlock x:Name="CountryText" VerticalAlignment="Center" Style="{StaticResource Text.Overline}" FontSize="14"/>
                                </StackPanel>
                                <TextBlock x:Name="NameText" Margin="0,6,0,0" Style="{StaticResource Text.Display}" FontSize="56"/>
                                <Border x:Name="ChampionBadge"
                                        Margin="0,10,0,0"
                                        Padding="12,4"
                                        HorizontalAlignment="Left"
                                        Background="{DynamicResource Brush.Accent}"
                                        Visibility="Collapsed">
                                    <TextBlock x:Name="ChampionBadgeText"
                                               FontFamily="{DynamicResource Font.Display}"
                                               FontSize="16"
                                               FontWeight="ExtraBold"
                                               Foreground="White"/>
                                </Border>
                                <WrapPanel Margin="0,20,0,0">
                                    <StackPanel x:Name="PermanentNumberPanel" Margin="0,0,32,10" Visibility="Collapsed">
                                        <TextBlock Text="Постійний номер (з 2014)" Style="{StaticResource Text.Caption}"/>
                                        <TextBlock x:Name="PermanentNumberText" Style="{StaticResource Text.H3}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,32,10">
                                        <TextBlock Text="Дата народження" Style="{StaticResource Text.Caption}"/>
                                        <TextBlock x:Name="BirthText" Style="{StaticResource Text.H3}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="Роки кар'єри" Style="{StaticResource Text.Caption}"/>
                                        <TextBlock x:Name="CareerText" Style="{StaticResource Text.H3}"/>
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                        <!-- Цифри кар'єри: смуга внизу шапки -->
                        <Border Grid.Row="1" BorderBrush="#2B2B30" BorderThickness="0,1,0,0" Background="#990C0C0E">
                            <ItemsControl x:Name="StatsList" Margin="32,16" Style="{StaticResource StatsBand}"/>
                        </Border>
                    </Grid>
                </Border>
                <StackPanel x:Name="CareerSection" Margin="0,24,0,0" Visibility="Collapsed">
                    <TextBlock Text="Кар'єра" Style="{StaticResource Text.H2}"/>
                    <!-- Таблиця сезонів (ширини збігаються з рядками) -->
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="76"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="72"/>
                            <ColumnDefinition Width="84"/>
                            <ColumnDefinition Width="72"/>
                            <ColumnDefinition Width="72"/>
                            <ColumnDefinition Width="64"/>
                            <ColumnDefinition Width="72"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="СЕЗОН" Margin="12,0,0,0" Style="{StaticResource Text.Caption}"/>
                        <TextBlock Grid.Column="1" Text="КОМАНДА" Style="{StaticResource Text.Caption}"/>
                        <TextBlock Grid.Column="2" Text="ПОЗ." HorizontalAlignment="Center" Style="{StaticResource Text.Caption}"/>
                        <TextBlock Grid.Column="3" Text="ОЧКИ" HorizontalAlignment="Center" Style="{StaticResource Text.Caption}"/>
                        <TextBlock Grid.Column="4" Text="ПЕРЕМОГИ" HorizontalAlignment="Center" Style="{StaticResource Text.Caption}"/>
                        <TextBlock Grid.Column="5" Text="ПОДІУМИ" HorizontalAlignment="Center" Style="{StaticResource Text.Caption}"/>
                        <TextBlock Grid.Column="6" Text="ПОУЛИ" HorizontalAlignment="Center" Style="{StaticResource Text.Caption}"/>
                        <TextBlock Grid.Column="7"
                                   Text="НОМЕР"
                                   HorizontalAlignment="Center"
                                   ToolTip="Номер у гонках цього сезону"
                                   Style="{StaticResource Text.Caption}"/>
                    </Grid>
                    <Border Height="1" Margin="0,8,0,0" Background="{DynamicResource Brush.BorderPrimary}"/>
                    <ItemsControl x:Name="CareerList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Рядок кар'єри: рік (перехід до сезону), команди (переходи до команд) і підсумки сезону -->
                                <Border BorderBrush="{DynamicResource Brush.BorderSubtle}"
                                        BorderThickness="0,0,0,1"
                                        Padding="0,10"
                                        Style="{StaticResource Row.Hover}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="76"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="72"/>
                                            <ColumnDefinition Width="84"/>
                                            <ColumnDefinition Width="72"/>
                                            <ColumnDefinition Width="72"/>
                                            <ColumnDefinition Width="64"/>
                                            <ColumnDefinition Width="72"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Button Content="{Binding Year}"
                                                Click="CareerYear_Click"
                                                Cursor="Hand"
                                                HorizontalAlignment="Left"
                                                Margin="12,0,0,0"
                                                ToolTip="Відкрити сезон">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource Breadcrumb.Link}">
                                                    <Setter Property="FontSize" Value="16"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsChampion}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <ItemsControl Grid.Column="1"
                                                      ItemsSource="{Binding Teams}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,12,0"
                                                      ItemsPanel="{StaticResource Panel.Wrap}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding Name}"
                                                            Click="CareerTeam_Click"
                                                            Margin="0,0,14,0"
                                                            FontSize="14"
                                                            Foreground="{DynamicResource Brush.TextSecondary}"
                                                            Style="{StaticResource Breadcrumb.Link}"
                                                            ToolTip="Відкрити команду"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding PositionText}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource Text.H3}"/>
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding PointsText}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource Text.H3}"/>
                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding Wins}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource Text.Body}"/>
                                        <TextBlock Grid.Column="5"
                                                   Text="{Binding Podiums}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource Text.Body}"/>
                                        <TextBlock Grid.Column="6"
                                                   Text="{Binding Poles}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource Text.Body}"/>
                                        <!-- Номер у гонках цього сезону (не постійний номер) -->
                                        <TextBlock Grid.Column="7"
                                                   Text="{Binding RaceNumbers}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   ToolTip="Номер у гонках цього сезону"
                                                   Style="{StaticResource Text.Body}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Margin="0,12,0,0"
                               Style="{StaticResource Text.Caption}"
                               TextWrapping="Wrap"
                               Text="Місце й очки показано за підсумковим заліком сезону. Якщо місця немає (—), гонщик не має місця в заліку: або не набрав очок, або виключений із заліку, про що сказано в примітці."/>
                </StackPanel>
                <StackPanel x:Name="TeamsSection" Margin="0,36,0,0" Visibility="Collapsed">
                    <TextBlock Text="Команди" Style="{StaticResource Text.H2}"/>
                    <ItemsControl x:Name="TeamsList" Margin="0,16,0,0" ItemsPanel="{StaticResource Panel.Columns4}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Card.Interactive}" Padding="16" Margin="0,0,14,14" Click="Team_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <ctl:MediaImage Width="44"
                                                        Height="44"
                                                        VerticalAlignment="Top"
                                                        ImageStretch="Uniform"
                                                        DecodeWidth="120"
                                                        SourcePath="{Binding LogoPath}"/>
                                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                            <TextBlock Text="{Binding Name}"
                                                       Style="{StaticResource Text.H3}"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap"/>
                                            <TextBlock Style="{StaticResource Text.Caption}">
                                                <Run Text="{Binding YearsText, Mode=OneWay}"/>
                                                <Run Text=" · "/>
                                                <Run Text="{Binding SeasonsText, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding StatsText}"
                                                       Margin="0,6,0,0"
                                                       Style="{StaticResource Text.Body}"
                                                       FontSize="14"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="Найбільше перемог із цією командою"
                                                       Margin="0,6,0,0"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource Brush.Accent}"
                                                       Visibility="{Binding IsMostSuccessful, Converter={StaticResource BoolToVisibility}}"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
