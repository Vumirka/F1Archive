<UserControl x:Class="F1Archive.Pages.CircuitDetailsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:F1Archive.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1280"
             d:DesignHeight="900"
             Background="{DynamicResource Brush.BackgroundPrimary}">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border MaxWidth="1320" Margin="32,24,32,48">
                <StackPanel>
                    <!-- ===== Шапка: назва, місце і основні дані траси ===== -->
                    <Border Background="{DynamicResource Brush.DarkPanel}">
                        <Border.Resources>
                            <ResourceDictionary Source="/F1Archive;component/Styles/Dark.xaml"/>
                        </Border.Resources>
                        <StackPanel>
                            <StackPanel Margin="48,36,48,32">
                                <TextBlock x:Name="LocationText" Style="{StaticResource Text.Overline}"/>
                                <TextBlock x:Name="NameText"
                                           Margin="0,4,0,0"
                                           TextWrapping="Wrap"
                                           Style="{StaticResource Text.Display}"
                                           FontSize="56"/>
                                <TextBlock x:Name="StatusText"
                                           Margin="0,8,0,0"
                                           Style="{StaticResource Text.Body}"
                                           FontSize="16"/>
                            </StackPanel>
                            <!-- Основні дані: смуга внизу шапки -->
                            <Border BorderBrush="#2B2B30" BorderThickness="0,1,0,0" Background="#990C0C0E">
                                <ItemsControl x:Name="StatsList" Margin="32,16" Style="{StaticResource StatsBand}"/>
                            </Border>
                        </StackPanel>
                    </Border>
                    <StackPanel Margin="0,24,0,0">
                        <!-- ===== Схема траси і відомості про неї ===== -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,16,0">
                                <StackPanel>
                                    <TextBlock Text="Схема траси" Style="{StaticResource Text.H3}"/>
                                    <Border Height="300"
                                            Margin="0,12,0,0"
                                            ClipToBounds="True"
                                            Background="{DynamicResource Brush.BackgroundSecondary}">
                                        <ctl:MediaImage x:Name="LayoutView" DecodeWidth="1000" ImageStretch="Uniform"/>
                                    </Border>
                                    <TextBlock x:Name="NoLayoutNote"
                                               Text="Схему цієї траси ще не додано до архіву."
                                               Margin="0,10,0,0"
                                               Style="{StaticResource Text.Caption}"
                                               Visibility="Collapsed"
                                               d:Visibility="Visible"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="24,20">
                                <StackPanel>
                                    <TextBlock Text="Про трасу" Style="{StaticResource Text.H3}"/>
                                    <UniformGrid Columns="2" Margin="0,8,0,0">
                                        <StackPanel Margin="0,8,12,0">
                                            <TextBlock Text="Країна" Style="{StaticResource Text.Caption}"/>
                                            <TextBlock x:Name="InfoCountryText"
                                                       Style="{StaticResource Text.H3}"
                                                       FontSize="17"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,8,0,0">
                                            <TextBlock Text="Місто" Style="{StaticResource Text.Caption}"/>
                                            <TextBlock x:Name="InfoCityText"
                                                       Style="{StaticResource Text.H3}"
                                                       FontSize="17"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,12,12,0">
                                            <TextBlock Text="Роки Гран-прі" Style="{StaticResource Text.Caption}"/>
                                            <TextBlock x:Name="InfoYearsText"
                                                       Style="{StaticResource Text.H3}"
                                                       FontSize="17"/>
                                        </StackPanel>
                                        <StackPanel x:Name="CoordinatesPanel" Margin="0,12,0,0" Visibility="Hidden">
                                            <TextBlock Text="Координати" Style="{StaticResource Text.Caption}"/>
                                            <TextBlock x:Name="CoordinatesText"
                                                       Style="{StaticResource Text.Body}"
                                                       Foreground="{DynamicResource Brush.TextPrimary}"/>
                                        </StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <!-- ===== Історія проведення: рік, Гран-прі і переможець, спочатку нові ===== -->
                        <StackPanel Margin="0,32,0,0">
                            <TextBlock Text="Історія проведення" Style="{StaticResource Text.H2}"/>
                            <Border Height="1" Margin="0,16,0,0" Background="{DynamicResource Brush.BorderPrimary}"/>
                            <ItemsControl x:Name="HistoryList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource Row.Line}" Click="HistoryItem_Click">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Year}" Style="{StaticResource Text.H3}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Text.Body}"/>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding WinnerName}"
                                                           Style="{StaticResource Text.Body}"
                                                           Foreground="{DynamicResource Brush.TextPrimary}"/>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
