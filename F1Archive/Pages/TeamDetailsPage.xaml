<UserControl x:Class="F1Archive.Pages.TeamDetailsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:F1Archive.Controls"
             Background="{DynamicResource Brush.BackgroundPrimary}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border MaxWidth="1320" Margin="32,24,32,48">
            <StackPanel>
                <Border ClipToBounds="True" Background="{DynamicResource Brush.DarkPanel}">
                    <Border.Resources>
                        <ResourceDictionary Source="/F1Archive;component/Styles/Dark.xaml"/>
                    </Border.Resources>
                    <StackPanel>
                        <Grid Margin="48,36,48,32">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="LogoBox"
                                    Width="200"
                                    Height="200"
                                    Padding="16"
                                    VerticalAlignment="Top"
                                    Background="White"
                                    BorderBrush="{DynamicResource Brush.BorderPrimary}"
                                    BorderThickness="1">
                                <ctl:MediaImage x:Name="Logo" DecodeWidth="480" ImageStretch="Uniform"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="32,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="CountryBadge"
                                            Padding="9,3"
                                            Margin="0,0,10,0"
                                            Background="{DynamicResource Brush.SurfaceElevated}"
                                            VerticalAlignment="Center"
                                            Visibility="Collapsed">
                                        <TextBlock x:Name="CountryCodeText"
                                                   FontFamily="{DynamicResource Font.Display}"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource Brush.TextPrimary}"/>
                                    </Border>
                                    <TextBlock x:Name="CountryText" VerticalAlignment="Center" Style="{StaticResource Text.Overline}" FontSize="14"/>
                                </StackPanel>
                                <TextBlock x:Name="NameText"
                                           Margin="0,6,0,0"
                                           TextWrapping="Wrap"
                                           Style="{StaticResource Text.Display}"
                                           FontSize="56"/>
                                <WrapPanel Margin="0,10,0,0">
                                    <Border x:Name="ChampionBadge"
                                            Padding="12,4"
                                            Margin="0,0,8,0"
                                            Background="{DynamicResource Brush.Accent}"
                                            Visibility="Collapsed">
                                        <TextBlock x:Name="ChampionBadgeText"
                                                   FontFamily="{DynamicResource Font.Display}"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   Foreground="White"/>
                                    </Border>
                                    <Border Padding="12,4" Background="{DynamicResource Brush.SurfaceElevated}">
                                        <TextBlock x:Name="StatusText"
                                                   FontFamily="{DynamicResource Font.Display}"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource Brush.TextPrimary}"/>
                                    </Border>
                                </WrapPanel>
                                <StackPanel Margin="0,20,0,10">
                                    <TextBlock Text="Роки участі" Style="{StaticResource Text.Caption}"/>
                                    <TextBlock x:Name="YearsText" Style="{StaticResource Text.H3}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <!-- Цифри команди: смуга внизу шапки -->
                        <Border BorderBrush="#2B2B30" BorderThickness="0,1,0,0" Background="#990C0C0E">
                            <ItemsControl x:Name="StatsList" Margin="32,16" Style="{StaticResource StatsBand}"/>
                        </Border>
                    </StackPanel>
                </Border>
                <!-- ===== Історія команди: Кубки конструкторів і сезони ===== -->
                <StackPanel x:Name="HistorySection" Margin="0,52,0,0" Visibility="Collapsed">
                    <TextBlock Text="Історія команди" Style="{StaticResource Text.H2}"/>
                    <!-- Роки Кубка конструкторів: клік відкриває сезон -->
                    <Border x:Name="TitlesCard" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="20,16" Visibility="Collapsed">
                        <DockPanel>
                            <TextBlock Text="Кубки конструкторів"
                                       Width="190"
                                       DockPanel.Dock="Left"
                                       Margin="0,4,0,0"
                                       Style="{StaticResource Text.Caption}"/>
                            <ItemsControl x:Name="TitleYearsList" ItemsPanel="{StaticResource Panel.Wrap}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding}"
                                                Style="{StaticResource Button.Secondary}"
                                                Padding="10,3"
                                                FontSize="15"
                                                Margin="0,0,8,8"
                                                Click="TitleYear_Click"
                                                ToolTip="Відкрити сезон"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                    </Border>
                    <!-- Сезони: спочатку останні 10, решта за кнопкою -->
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="76"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="84"/>
                            <ColumnDefinition Width="84"/>
                            <ColumnDefinition Width="84"/>
                            <ColumnDefinition Width="170"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="СЕЗОН" Margin="12,0,0,0" Style="{StaticResource Text.Caption}"/>
                        <TextBlock Grid.Column="1" Text="ГОНЩИКИ" Style="{StaticResource Text.Caption}"/>
                        <TextBlock Grid.Column="2" Text="ГРАН-ПРІ" HorizontalAlignment="Center" Style="{StaticResource Text.Caption}"/>
                        <TextBlock Grid.Column="3" Text="ПЕРЕМОГИ" HorizontalAlignment="Center" Style="{StaticResource Text.Caption}"/>
                        <TextBlock Grid.Column="4" Text="ПОДІУМИ" HorizontalAlignment="Center" Style="{StaticResource Text.Caption}"/>
                        <TextBlock Grid.Column="5" Text="КУБОК КОНСТРУКТОРІВ" HorizontalAlignment="Center" Style="{StaticResource Text.Caption}"/>
                    </Grid>
                    <Border Height="1" Margin="0,8,0,0" Background="{DynamicResource Brush.BorderPrimary}"/>
                    <ItemsControl x:Name="SeasonsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Рядок сезону команди: рік (перехід до сезону), гонщики (переходи до профілів), підсумки.
                                     Очки Кубка конструкторів не показуються: повної таблиці конструкторів у базі немає. -->
                                <Border BorderBrush="{DynamicResource Brush.BorderSubtle}"
                                        BorderThickness="0,0,0,1"
                                        Padding="0,10"
                                        Style="{StaticResource Row.Hover}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="76"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="84"/>
                                            <ColumnDefinition Width="84"/>
                                            <ColumnDefinition Width="84"/>
                                            <ColumnDefinition Width="170"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Content="{Binding Year}"
                                                Click="SeasonYear_Click"
                                                Cursor="Hand"
                                                HorizontalAlignment="Left"
                                                Margin="12,0,0,0"
                                                ToolTip="Відкрити сезон">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource Breadcrumb.Link}">
                                                    <Setter Property="FontSize" Value="16"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsChampion}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <ItemsControl Grid.Column="1"
                                                      ItemsSource="{Binding Drivers}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,12,0"
                                                      ItemsPanel="{StaticResource Panel.Wrap}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding Name}"
                                                            Click="SeasonDriver_Click"
                                                            Margin="0,0,14,0"
                                                            FontSize="14"
                                                            Foreground="{DynamicResource Brush.TextSecondary}"
                                                            Style="{StaticResource Breadcrumb.Link}"
                                                            ToolTip="Відкрити гонщика"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding GrandPrix}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource Text.Body}"/>
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding Wins}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource Text.H3}"/>
                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding Podiums}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource Text.Body}"/>
                                        <TextBlock Grid.Column="5"
                                                   Text="{Binding StatusText}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   FontFamily="{DynamicResource Font.Ui}"
                                                   FontSize="13">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsChampion}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button x:Name="AllSeasonsButton"
                            Style="{StaticResource Button.Secondary}"
                            HorizontalAlignment="Center"
                            Margin="0,16,0,0"
                            Visibility="Collapsed"
                            Click="AllSeasons_Click"/>
                </StackPanel>
                <!-- ===== Гонщики: спершу ті, хто виграв найбільше ===== -->
                <StackPanel x:Name="DriversSection" Margin="0,36,0,0" Visibility="Collapsed">
                    <TextBlock Text="Гонщики команди" Style="{StaticResource Text.H2}"/>
                    <ItemsControl x:Name="DriversList" Margin="0,16,0,0" ItemsPanel="{StaticResource Panel.Columns4}">
                        <ItemsControl.ItemTemplate>
                            <!-- Гонщик команди: плитка як у "Учасниках сезону" -->
                            <DataTemplate>
                                <Button Style="{StaticResource Card.Interactive}"
                                        Padding="16"
                                        Margin="0,0,14,14"
                                        ToolTip="{Binding StatsText}"
                                        Click="TeamDriver_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <ctl:MediaImage Width="52"
                                                        Height="52"
                                                        VerticalAlignment="Top"
                                                        DecodeWidth="120"
                                                        SourcePath="{Binding ImagePath}"/>
                                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                            <TextBlock Text="{Binding Name}"
                                                       Style="{StaticResource Text.H3}"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap"/>
                                            <TextBlock Text="{Binding YearsText}"
                                                       Style="{StaticResource Text.Caption}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding StatsText}" Margin="0,6,0,0" Style="{StaticResource Text.Body}" FontSize="14"/>
                                            <TextBlock Text="{Binding TitlesText}"
                                                       Margin="0,2,0,0"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource Brush.Accent}"
                                                       Visibility="{Binding HasTitles, Converter={StaticResource BoolToVisibility}}"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button x:Name="AllDriversButton"
                            Style="{StaticResource Button.Secondary}"
                            HorizontalAlignment="Center"
                            Margin="0,6,0,0"
                            Visibility="Collapsed"
                            Click="AllDrivers_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
