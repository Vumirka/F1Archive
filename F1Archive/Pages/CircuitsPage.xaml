<UserControl x:Class="F1Archive.Pages.CircuitsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:F1Archive.Controls"
             Background="{DynamicResource Brush.BackgroundPrimary}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border MaxWidth="1320" Margin="32,28,32,48">
            <StackPanel>
                <TextBlock Text="ТРАСИ" Style="{StaticResource Text.Overline}"/>
                <TextBlock Text="Траси Формули 1" Margin="0,6,0,0" Style="{StaticResource Text.H1}"/>
                <TextBlock x:Name="SummaryText" Margin="0,8,0,20" Style="{StaticResource Text.Body}"/>
                <!-- Фільтри: пошук і "Діючі" зліва -->
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBox x:Name="SearchBox"
                             Width="320"
                             Margin="0,0,12,8"
                             Style="{StaticResource TextBox.Search}"
                             Tag="Назва, місто або країна"
                             TextChanged="Filter_Changed"/>
                    <CheckBox x:Name="ActiveCheck"
                              Content="Лише діючі"
                              Style="{StaticResource ChipCheck}"
                              VerticalAlignment="Top"
                              Click="Filter_Changed"/>
                </StackPanel>
                <TextBlock x:Name="CountText" Margin="0,6,0,14" Style="{StaticResource Text.Caption}"/>
                <!-- Картки трас: як у гонщиків, схема зліва, дані справа -->
                <ItemsControl x:Name="CardsList" ItemsPanel="{StaticResource Panel.Columns3}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Картка траси: велика схема згори, код країни на ній, внизу назва і цифри -->
                            <Button Style="{StaticResource Card.Interactive}" Height="320" Padding="0" Margin="0,0,16,16" Click="Card_Click">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Border BorderBrush="{DynamicResource Brush.BorderSubtle}"
                                            BorderThickness="0,0,0,1"
                                            Background="{DynamicResource Brush.BackgroundSecondary}">
                                        <ctl:MediaImage DecodeWidth="480" ImageStretch="Uniform" SourcePath="{Binding LayoutImagePath}"/>
                                    </Border>
                                    <Border HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Margin="12"
                                            Padding="8,3"
                                            Background="{DynamicResource Brush.Asphalt}"
                                            Visibility="{Binding HasCountryCode, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding CountryCode}"
                                                   FontFamily="{DynamicResource Font.Display}"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Foreground="White"/>
                                    </Border>
                                    <StackPanel Grid.Row="1" Margin="18,12,18,14">
                                        <DockPanel>
                                            <TextBlock Text="ДІЮЧА"
                                                       DockPanel.Dock="Right"
                                                       Margin="10,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource Text.Overline}"
                                                       FontSize="12"
                                                       Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}"/>
                                            <TextBlock Text="{Binding Name}"
                                                       Style="{StaticResource Text.H3}"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding LocationText}"
                                                   Style="{StaticResource Text.Caption}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <UniformGrid Columns="3" Margin="0,10,0,0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding LengthText}" Style="{StaticResource Text.H3}" FontSize="16"/>
                                                <TextBlock Text="довжина" Style="{StaticResource Text.Caption}" FontSize="12"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="{Binding GrandPrixCount}" Style="{StaticResource Text.H3}" FontSize="16"/>
                                                <TextBlock Text="Гран-прі" Style="{StaticResource Text.Caption}" FontSize="12"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="{Binding FirstYear, TargetNullValue=—}"
                                                           Style="{StaticResource Text.H3}"
                                                           FontSize="16"/>
                                                <TextBlock Text="перший рік" Style="{StaticResource Text.Caption}" FontSize="12"/>
                                            </StackPanel>
                                        </UniformGrid>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button x:Name="MoreButton"
                        Style="{StaticResource Button.Secondary}"
                        HorizontalAlignment="Center"
                        Margin="0,8,0,0"
                        Padding="32,12"
                        Visibility="Collapsed"
                        Click="More_Click"/>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
