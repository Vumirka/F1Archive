<edit:EditPage x:Class="F1Archive.Editing.CircuitsEdit"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:edit="clr-namespace:F1Archive.Editing"
             xmlns:ctl="clr-namespace:F1Archive.Controls"
             Background="{DynamicResource Brush.BackgroundPrimary}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="440"/>
        </Grid.ColumnDefinitions>

        <DockPanel Margin="0,0,24,0">
            <TextBox x:Name="SearchBox"
                     Style="{StaticResource TextBox.Search}"
                     DockPanel.Dock="Top"
                     Margin="0,0,0,12"
                     Tag="Пошук за назвою, країною або містом"
                     TextChanged="Search_Changed"/>
            <DataGrid x:Name="List" SelectionChanged="List_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Траса" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Країна" Binding="{Binding Country}" Width="*"/>
                    <DataGridTextColumn Header="Місто" Binding="{Binding City}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <Border Grid.Column="1" Style="{StaticResource Card}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                    <TextBlock x:Name="StatusText" Margin="0,0,0,10" TextWrapping="Wrap"/>
                    <WrapPanel>
                        <Button Content="Зберегти" Style="{StaticResource Button.Primary}" Margin="0,0,8,8" Click="Save_Click"/>
                        <Button Content="Новий запис" Margin="0,0,8,8" Click="New_Click"/>
                        <Button x:Name="DeleteButton"
                                Content="Видалити"
                                Style="{StaticResource Button.Danger}"
                                Margin="0,0,8,8"
                                Click="Delete_Click"/>
                    </WrapPanel>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock x:Name="FormTitle" Style="{StaticResource Text.H3}"/>
                        <TextBlock Text="Назва *" Style="{StaticResource Text.Label}"/>
                        <TextBox x:Name="NameBox"/>
                        <TextBlock Text="Країна" Style="{StaticResource Text.Label}"/>
                        <TextBox x:Name="CountryBox"/>
                        <TextBlock Text="Місто" Style="{StaticResource Text.Label}"/>
                        <TextBox x:Name="CityBox"/>
                        <TextBlock Text="Довжина кола, км" Style="{StaticResource Text.Label}"/>
                        <TextBox x:Name="LengthBox"/>
                        <TextBlock Text="Кількість поворотів" Style="{StaticResource Text.Label}"/>
                        <TextBox x:Name="TurnsBox"/>
                        <TextBlock Text="Широта" Style="{StaticResource Text.Label}"/>
                        <TextBox x:Name="LatitudeBox"/>
                        <TextBlock Text="Довгота" Style="{StaticResource Text.Label}"/>
                        <TextBox x:Name="LongitudeBox"/>
                        <TextBlock Text="Схема траси" Style="{StaticResource Text.Label}"/>
                        <Border Height="200" Background="{DynamicResource Brush.BackgroundSecondary}">
                            <ctl:MediaImage x:Name="Photo" ImageStretch="Uniform" DecodeWidth="800"/>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Обрати фото" Margin="0,0,8,0" Click="ChoosePhoto_Click"/>
                            <Button Content="Прибрати фото" Click="RemovePhoto_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</edit:EditPage>
