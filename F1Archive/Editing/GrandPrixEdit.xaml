<edit:EditPage x:Class="F1Archive.Editing.GrandPrixEdit"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:edit="clr-namespace:F1Archive.Editing"
             Background="{DynamicResource Brush.BackgroundPrimary}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="440"/>
        </Grid.ColumnDefinitions>

        <DockPanel Margin="0,0,24,0">
            <!-- Сезон: вибір і його дані (рік, етапи, чемпіони) -->
            <Border DockPanel.Dock="Top"
                    Style="{StaticResource Card}"
                    Padding="18,14"
                    Margin="0,0,0,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Сезон" VerticalAlignment="Center" Style="{StaticResource Text.H3}"/>
                        <ComboBox x:Name="SeasonFilter"
                                  Width="140"
                                  Margin="12,0,0,0"
                                  SelectionChanged="Filter_Changed"/>
                    </StackPanel>
                    <UniformGrid Columns="4">
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Рік *" Style="{StaticResource Text.Label}"/>
                            <TextBox x:Name="YearBox"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Етапів у сезоні" Style="{StaticResource Text.Label}"/>
                            <TextBox x:Name="RoundsBox"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Чемпіон світу" Style="{StaticResource Text.Label}"/>
                            <ComboBox x:Name="ChampionBox"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Кубок конструкторів" Style="{StaticResource Text.Label}"/>
                            <ComboBox x:Name="ChampionTeamBox"/>
                        </StackPanel>
                    </UniformGrid>
                    <WrapPanel Margin="0,12,0,0">
                        <Button Content="Зберегти сезон" Margin="0,0,8,0" Click="SaveSeason_Click"/>
                        <Button Content="Новий сезон" Margin="0,0,8,0" Click="NewSeason_Click"/>
                        <Button Content="Видалити сезон"
                                Style="{StaticResource Button.Danger}"
                                Margin="0,0,12,0"
                                Click="DeleteSeason_Click"/>
                        <TextBlock x:Name="SeasonStatusText" VerticalAlignment="Center"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
            <DataGrid x:Name="List" SelectionChanged="List_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Етап" Binding="{Binding RoundNumber}" Width="60"/>
                    <DataGridTextColumn Header="Гран-прі" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="110"/>
                    <DataGridTextColumn Header="Траса" Binding="{Binding Circuit.Name}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <Border Grid.Column="1" Style="{StaticResource Card}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                    <TextBlock x:Name="StatusText" Margin="0,0,0,10" TextWrapping="Wrap"/>
                    <WrapPanel>
                        <Button Content="Зберегти"
                                Style="{StaticResource Button.Primary}"
                                Margin="0,0,8,8"
                                Click="Save_Click"/>
                        <Button Content="Новий запис" Margin="0,0,8,8" Click="New_Click"/>
                        <Button x:Name="DeleteButton"
                                Content="Видалити"
                                Style="{StaticResource Button.Danger}"
                                Margin="0,0,8,8"
                                Click="Delete_Click"/>
                    </WrapPanel>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock x:Name="FormTitle" Style="{StaticResource Text.H3}"/>
                        <TextBlock Text="Назва *" Style="{StaticResource Text.Label}"/>
                        <TextBox x:Name="NameBox"/>
                        <TextBlock Text="Номер етапу *" Style="{StaticResource Text.Label}"/>
                        <TextBox x:Name="RoundBox"/>
                        <TextBlock Text="Дата * (дд.мм.рррр)" Style="{StaticResource Text.Label}"/>
                        <TextBox x:Name="DateBox"/>
                        <TextBlock Text="Траса *" Style="{StaticResource Text.Label}"/>
                        <ComboBox x:Name="CircuitBox"/>
                        <TextBlock Text="Кількість кіл" Style="{StaticResource Text.Label}"/>
                        <TextBox x:Name="LapsBox"/>
                        <TextBlock Text="Поул-позиція" Style="{StaticResource Text.Label}"/>
                        <ComboBox x:Name="PoleBox"/>
                        <TextBlock Text="Найшвидше коло: гонщик" Style="{StaticResource Text.Label}"/>
                        <ComboBox x:Name="FastestDriverBox"/>
                        <TextBlock Text="Найшвидше коло: час" Style="{StaticResource Text.Label}"/>
                        <TextBox x:Name="FastestTimeBox"/>
                        <TextBlock Text="Найшвидше коло: номер кола" Style="{StaticResource Text.Label}"/>
                        <TextBox x:Name="FastestLapBox"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</edit:EditPage>
